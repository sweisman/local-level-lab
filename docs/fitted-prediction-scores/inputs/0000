9536e-06,"gyro_bias_y":4.84813681109536e-06,"gyro_bias_z":4.84813681109536e-06,"gyro_gain_x":0.01,"gyro_gain_y":0.01,"gyro_gain_z":0.01,"lever_x":5.0,"lever_y":5.0,"lever_z":5.0,"position_x":100.0,"position_y":100.0,"position_z":100.0,"time_offset":0.01,"velocity_x":20.0,"velocity_y":20.0,"velocity_z":20.0},"maximum_evaluations":200,"maximum_wall_s":7200.0,"method":"linear_points","models":["sphere_rotating","sphere_still","flat_still"],"noise_by_law":{"increment":{"accel_bias_stationary_mps2":5e-05,"accel_bias_tau_s":300.0,"accel_white_mps_per_sqrt_s":0.0002,"estimated_from_observed_errors":false,"gyro_bias_stationary_rads":2.42406840554768e-07,"gyro_bias_tau_s":600.0,"gyro_white_rads_per_sqrt_s":5.817764173314432e-06,"seed":26062413,"values_are_hardware_specifications":false,"version":"esa-synthetic-noise-v1"},"point":{"accel_bias_stationary_mps2":5e-05,"accel_bias_tau_s":300.0,"accel_point_std_mps2":0.0034641016151377548,"estimated_from_observed_errors":false,"gyro_bias_stationary_rads":2.42406840554768e-07,"gyro_bias_tau_s":600.0,"gyro_point_std_rads":0.00010076663134634545,"input_error_law":"linear_rate_points","seed":26062413,"values_are_hardware_specifications":false,"version":"esa-synthetic-rate-point-noise-v1"}},"observed_starts":0,"original_reads":0,"pattern":"fast","policies":["reported-short-v1"],"prediction_target":"physical_position","profiles":[false,true],"queries":119,"query_start_s":0.5,"query_step_s":1.0,"rank_rtol":1e-10,"rate_hz":300,"receiver_transform_policy":"last-training-transform-v1","retries":0,"starts":2,"stopping":"near_zero","threads":1,"training_sigma_m":0.01,"version":"structured-noisy-training-v1","workers":4},"sources":{"analysis/lll/airquantumgrav_observation_truth.py":"# SPDX-License-Identifier: AGPL-3.0-or-later\n\"\"\"Known synthetic sensor errors and antenna geometry, without navigation code.\n\nValues here define software fixtures, not ESA device specifications or an\nestimator. Recorded channels and fused navigation never enter this module.\n\"\"\"\nimport math\n\nfrom lll.airquantumgrav_truth import A,E2,DISC_RADIUS,GRAVITY,MODELS\n\n\ndef _check(case,sign):\n    import numpy as np\n    if type(sign) is not int or sign not in (-1,1):\n        raise ValueError('one of the two declared calibration signs required')\n    shapes=dict(coordinates=(3,),velocity_local_mps=(3,),attitude_body_to_local=(3,3),\n        position_world_m=(3,),body_axes_world=(3,3),angular_rate_rads=(3,),specific_force_mps2=(3,))\n    n=len(case.get('coordinates',[]))\n    if not n:raise ValueError('nonempty independent geometric truth required')\n    for name,shape in shapes.items():\n        value=np.asarray(case.get(name),float)\n        if value.shape!=(n,*shape) or not np.all(np.isfinite(value)):\n            raise ValueError('aligned finite independent geometric channels required')\n\n\ndef _parameters(sign):\n    vectors=dict(attitude=(.002,-.003,.004),velocity=(.1,-.2,.15),\n        gyro_bias=tuple(math.radians(v)/3600 for v in (.15,-.2,.25)),\n        accel_bias=(.01,-.02,.015),gyro_gain=(.002,-.0015,.001),\n        accel_gain=(.003,-.002,.004),lever=(1.5,-.7,.4))\n    result={name+'_'+axis:sign*v for name,values in vectors.items() for axis,v in zip('xyz',values)}\n    result.update(gravity_delta=sign*.01,time_offset=sign*.0007)\n    return result\n\n\ndef observe(case,*,sign):\n    \"\"\"Apply a known affine sensor error to engineering-unit rate samples.\"\"\"\n    import numpy as np\n    _check(case,sign);p=_parameters(sign)\n    vector=lambda name:np.array([p[name+'_'+a] for a in 'xyz'])\n    return dict(angular_rate_rads=np.asarray(case['angular_rate_rads'])*(1+vector('gyro_gain'))+vector('gyro_bias'),\n        specific_force_mps2=np.asarray(case['specific_force_mps2'])*(1+vector('accel_gain'))+vector('accel_bias'),\n        generated_not_observed=True)\n\n\ndef antenna(case,*,sign):\n    \"\"\"Move the answer point in Cartesian space, independently of coordinate rates.\"\"\"\n    import numpy as np\n    _check(case,sign);lever=sign*np.array([1.5,-.7,.4]);answer=dict(case)\n    answer['position_world_m']=np.asarray(case['position_world_m'])+np.einsum('nij,j->ni',case['body_axes_world'],lever)\n    return answer\n\n\ndef receiver_coordinates(position_world_m,*,model):\n    \"\"\"Convert independent Cartesian antenna truth to receiver coordinates.\n\n    This inverse uses ellipsoid normal geometry, never a navigation prediction.\n    It creates generated receiver samples only; it repairs no recorded data.\n    \"\"\"\n    import numpy as np\n    xyz=np.asarray(position_world_m,float)\n    if (model not in MODELS or xyz.ndim!=2 or xyz.shape[1:]!=(3,) or not len(xyz)\n            or not np.all(np.isfinite(xyz))):\n        raise ValueError('finite nonempty Cartesian points and declared geometry required')\n    x,y,z=xyz.T;rho=np.hypot(x,y)\n    if np.any(rho<=0):raise ValueError('nonpolar nonzero horizontal position required')\n    longitude=np.arctan2(y,x)\n    if model=='flat_still':\n        phi=math.pi/2-rho/DISC_RADIUS;height=z.copy()\n        if np.any(abs(phi)>=math.pi/2):raise ValueError('Cartesian point outside the declared disc coordinate domain')\n    else:\n        phi=np.arctan2(z,rho*(1-E2))\n        for _ in range(20):\n            radius=A/np.sqrt(1-E2*np.sin(phi)**2)\n            following=np.arctan2(z+E2*radius*np.sin(phi),rho)\n            difference=float(np.max(abs(following-phi)));phi=following\n            if difference<=2e-15:break\n        else:raise ValueError('independent ellipsoid inversion did not converge')\n        height=rho*np.cos(phi)+z*np.sin(phi)-A*np.sqrt(1-E2*np.sin(phi)**2)\n    result=np.column_stack((phi,longitude,height))\n    if not np.all(np.isfinite(result)):raise ValueError('finite generated receiver coordinates required')\n    return result\n\n\ndef receiver_samples(model,times,*,latitude_deg,pattern,removal,sign,height_profile=None,gravity_model='constant'):\n    \"\"\"Generate just the requested receiver observations, including antenna latency.\n\n    No true starting state or correction vector is returned to the estimator.\n    Caller-owned construction accounting must precede this numerical operation.\n    \"\"\"\n    import numpy as np\n    from lll.airquantumgrav_truth import truth\n    if type(sign) is not int or sign not in (-1,1):raise ValueError('declared calibration sign required')\n    case=truth(model,np.asarray(times,float)+_parameters(sign)['time_offset'],\n        latitude_deg=latitude_deg,pattern=pattern,removal=removal,height_profile=height_profile,gravity_model=gravity_model)\n    answer=antenna(case,sign=sign)\n    answer['coordinates']=receiver_coordinates(answer['position_world_m'],model=model)\n    return {k:answer[k] for k in ('coordinates','position_world_m','body_axes_world','attitude_body_to_local')}\n\n\ndef start(case,*,model,sign):\n    \"\"\"Give a perturbed starting state and its exact declared correction vector.\n\n    Supplying this vector checks application, not recovery from observations.\n    The local metric is derived from the independent geometric definition.\n    \"\"\"\n    import numpy as np\n    _check(case,sign)\n    if model not in MODELS:raise ValueError('declared generating geometry required')\n    p=_parameters(sign);true=np.asarray(case['coordinates'][0]);base=true+sign*np.array([.5e-6,-.4e-6,2.])\n    phi,h=base[0],base[2]\n    if model=='flat_still':mn,me=DISC_RADIUS,DISC_RADIUS*(math.pi/2-phi)\n    else:\n        q=1-E2*math.sin(phi)**2;mn=A*(1-E2)/q**1.5+h;me=(A/math.sqrt(q)+h)*math.cos(phi)\n    for axis,value in zip('xyz',(true-base)*[mn,me,-1.]):p['position_'+axis]=float(value)\n    rotation_vector=-np.array([p['attitude_'+a] for a in 'xyz']);angle=float(np.linalg.norm(rotation_vector))\n    x,y,z=rotation_vector;cross=np.array([[0.,-z,y],[z,0.,-x],[-y,x,0.]])\n    undo=np.eye(3)+math.sin(angle)/angle*cross+(1-math.cos(angle))/angle**2*(cross@cross)\n    initial=dict(latitude_rad=float(base[0]),longitude_rad=float(base[1]),height_m=float(base[2]),\n        velocity_ned_mps=np.asarray(case['velocity_local_mps'][0])-[p['velocity_'+a] for a in 'xyz'],\n        attitude_body_to_ned=np.asarray(case['attitude_body_to_local'][0])@undo)\n    return dict(initial=initial,parameters=p,gravity_mps2=GRAVITY-p['gravity_delta'],\n        corrections_supplied_not_fitted=True,generated_not_observed=True)\n","analysis/lll/ilvis0_solver_position.py":"# SPDX-License-Identifier: AGPL-3.0-or-later\n\"\"\"Separate actual-position stability rule; frozen solvers remain unchanged.\"\"\"\nimport importlib.util\nfrom pathlib import Path\n\nimport numpy as np\nfrom scipy.optimize import lsq_linear\n\nfrom . import ilvis0_solver_boundary as boundary\nfrom .ilvis0_solver_refinement import POLICY as STOPPING, projected_stationarity\n\nVERSION = 'ilvis0-actual-position-stability-v1'\nPOLICY = dict(boundary.POLICY, stability='fresh actual position, cost and stationarity',\n              position_rms_tolerance_m=.001, position_max_tolerance_m=.01,\n              position_metric='common receiver-local NEU coordinate conversion',\n              predicted_residual_step_is_gate=False,\n              numerical_limits_are_instrument_accuracy=False)\n\n\ndef physical_metric(gps):\n    gps = np.asarray(gps, float)\n    if gps.ndim != 2 or gps.shape[1] != 3 or not np.all(np.isfinite(gps)):\n        raise ValueError('finite receiver coordinates required for physical conversion')\n    phi, height = gps[:, 0], gps[:, 2]\n    d = 1-6.6943799901413165e-3*np.sin(phi)**2\n    return np.column_stack((6378137.*(1-6.6943799901413165e-3)/d**1.5+height,\n                            (6378137./np.sqrt(d)+height)*np.cos(phi), np.ones(len(gps))))\n\n\ndef physical_residual_step(problem, delta):\n    \"\"\"Undo shared covariance whitening to compare actual coordinate predictions.\n\n    The same measured receiver coordinates define the unit conversion for every\n    model. This is a numerical stability check, not a new observation likelihood.\n    \"\"\"\n    delta = np.asarray(delta, float)\n    m = len(problem.gps)\n    if delta.shape != (3*m,) or not np.all(np.isfinite(delta)):\n        raise ValueError('invalid physical residual conversion')\n    inverse = getattr(problem,'unwhiten_stacked',None)\n    if callable(inverse):\n        coordinates = np.asarray(inverse(delta),float)\n        if coordinates.shape != (3*m,) or not np.all(np.isfinite(coordinates)):\n            raise ValueError('invalid structured physical residual conversion')\n        coordinates = coordinates.reshape(m,3)\n    else:\n        cholesky = np.asarray(problem.cholesky, float)\n        if cholesky.shape != (3*m,3*m) or not np.all(np.isfinite(cholesky)):\n            raise ValueError('invalid physical residual conversion')\n        coordinates = (cholesky @ delta).reshape(m, 3)\n    coordinates[:, 1] = (coordinates[:, 1]+np.pi) % (2*np.pi)-np.pi\n    return coordinates*physical_metric(problem.gps)\n\n\ndef verify_stability(point, residual, jac, evaluate, physical_step):\n    stationarity = projected_stationarity(point, residual, jac)[0]\n    if stationarity > STOPPING['stationarity_tolerance']:\n        return dict(passed=False, reason='not_stationary')\n    correction = lsq_linear(jac, -residual, bounds=(-1-point, 1-point), method='bvls',\n                            tol=STOPPING['stability_probe_linear_tolerance'],\n                            max_iter=STOPPING['stability_probe_linear_maximum_iterations'])\n    if not correction.success or not np.all(np.isfinite(correction.x)):\n        return dict(passed=False, reason='local_linear_solve_unfinished')\n    cost = float(residual @ residual)\n    predicted = residual+jac @ correction.x\n    predicted_cost = float(predicted @ predicted)\n    probe = np.clip(point+correction.x, -1., 1.)\n    fresh, fresh_jac, _ = evaluate(probe, fresh=True)\n    difference = np.asarray(physical_step(fresh-residual), float)\n    if (difference.ndim != 2 or difference.shape[1] != 3 or not len(difference)\n            or not np.all(np.isfinite(difference))):\n        raise ValueError('invalid physical prediction difference')\n    rms = np.sqrt(np.mean(difference**2, axis=0))\n    maximum = np.max(abs(difference), axis=0)\n    actual_cost = float(fresh @ fresh)\n    change = abs(actual_cost-cost)/max(actual_cost, cost, 1.)\n    fresh_stationarity = projected_stationarity(probe, fresh, fresh_jac)[0]\n    passed = bool(change <= STOPPING['relative_cost_tolerance']\n                  and fresh_stationarity <= STOPPING['stationarity_tolerance']\n                  and np.all(rms <= POLICY['position_rms_tolerance_m'])\n                  and np.all(maximum <= POLICY['position_max_tolerance_m']))\n    return dict(passed=passed,\n                reason='fresh_position_stability_verified' if passed else 'fresh_position_probe_not_stable',\n                predicted_cost_change=abs(predicted_cost-cost)/max(predicted_cost, cost, 1.),\n                predicted_residual_step=float(np.linalg.norm(predicted-residual)/max(np.linalg.norm(residual), 1.)),\n                actual_cost_change=change,\n                actual_residual_step=float(np.linalg.norm(fresh-residual)/max(np.linalg.norm(residual), 1.)),\n                fresh_stationarity=fresh_stationarity,\n                normalized_parameter_step=float(np.linalg.norm(probe-point)),\n                position_rms_neu_m=rms.tolist(), position_max_abs_neu_m=maximum.tolist(),\n                position_rms_tolerance_m=POLICY['position_rms_tolerance_m'],\n                position_max_tolerance_m=POLICY['position_max_tolerance_m'])\n\n\ndef fit_candidate(problem, model, *, start, maximum_evaluations=600, physical_step=None):\n    # Load a private instance rather than changing the frozen solver's globals.\n    # The actual bounded-step algorithm and its finite accounting stay identical.\n    spec = importlib.util.spec_from_file_location('lll._position_boundary_core', Path(boundary.__file__))\n    core = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(core)\n    transform = physical_step if physical_step is not None else lambda delta: physical_residual_step(problem, delta)\n    core.verify_stability = lambda u, r, j, evaluate: verify_stability(u, r, j, evaluate, transform)\n    result = core.fit_candidate(problem, model, start=start, maximum_evaluations=maximum_evaluations)\n    result.update(version=VERSION, stability_policy=POLICY,\n                  termination='fresh_position_stability' if result['converged'] else 'unresolved')\n    return result\n","analysis/lll/ilvis0_solver_refinement.py":"# SPDX-License-Identifier: AGPL-3.0-or-later\n\"\"\"Separate bounded solver experiment; the completed airborne fitter stays frozen.\"\"\"\nimport numpy as np\nfrom scipy.optimize import least_squares, lsq_linear\n\nfrom .ilvis0_estimator import EvaluationLimit\n\nVERSION = 'ilvis0-scaled-stable-stop-v1'\nPOLICY = dict(stationarity_tolerance=1e-4, relative_cost_tolerance=1e-8,\n              relative_residual_step_tolerance=1e-6, stable_iterations=3,\n              bound_projection_tolerance=1e-6, ftol=None, xtol=1e-11, gtol=1e-14,\n              x_scale='jac', maximum_evaluations=200, diagnostic_reserve=2,\n              initialization_maximum_evaluations=25, stability_probe_linear_tolerance=1e-10,\n              stability_probe_linear_maximum_iterations=100)\n\n\ndef projected_stationarity(point, residual, jac):\n    gradient = jac.T@residual\n    projected = gradient.copy()\n    projected[(point <= -1+1e-6)&(gradient > 0)] = 0.\n    projected[(point >= 1-1e-6)&(gradient < 0)] = 0.\n    scale = np.maximum(np.linalg.norm(jac, axis=0), 1.)*max(np.linalg.norm(residual), 1.)\n    relative = projected/scale\n    value = float(np.max(abs(relative))) if len(point) else 0.\n    return value, gradient, projected, relative\n\n\nclass StableStop:\n    \"\"\"Three accepted measurement-space steps must be stable and stationary.\n\n    Parameter motion in an almost-null direction need not become uniquely determined.\n    Stability describes the predicted observations, not identification of calibration.\n    \"\"\"\n    def __init__(self):\n        self.previous = None\n        self.streak = 0\n        self.stationarity = float('inf')\n        self.cost_change = None\n        self.residual_step = None\n        self.stable = False\n\n    def observe(self, point, residual, jac):\n        self.stationarity = projected_stationarity(point, residual, jac)[0]\n        cost = float(residual@residual)\n        self.stable = False\n        if self.previous is not None:\n            old_cost, old_residual = self.previous\n            self.cost_change = abs(cost-old_cost)/max(cost, old_cost, 1.)\n            self.residual_step = float(np.linalg.norm(residual-old_residual)/max(np.linalg.norm(residual), 1.))\n            self.stable = (self.cost_change <= POLICY['relative_cost_tolerance'] and\n                           self.residual_step <= POLICY['relative_residual_step_tolerance'])\n        self.streak = self.streak+1 if self.stable and self.stationarity <= 1e-4 else 0\n        self.previous = cost, residual.copy()\n        return self.streak >= POLICY['stable_iterations']\n\n\ndef fit_candidate(problem, model, *, start=None, maximum_evaluations=200):\n    \"\"\"Count every tangent sweep, reserve final fresh tangent and two predictions.\n\n    Ordinary xtol stopping also requires measured step/cost stability and the fresh\n    projected-gradient check. An exhausted budget alone never establishes convergence.\n    Initialization, feasible box and residual/Jacobian are unchanged from the baseline.\n    \"\"\"\n    if not 4 <= maximum_evaluations <= 200:\n        raise ValueError('finite evaluation allowance in [4,200] required')\n    point = np.zeros(len(problem.bounds.active)) if start is None else np.array(start, float)\n    problem.bounds.decode(point)\n    calls = 0; cache = None; best = None; limit = maximum_evaluations-3\n\n    def evaluate(u, fresh=False):\n        nonlocal calls, cache, best\n        if not fresh and cache is not None and np.array_equal(u, cache[0]):\n            return cache[1:]\n        if calls >= limit:\n            raise EvaluationLimit('native tangent evaluation allowance exhausted')\n        calls += 1\n        residual, jac, boundaries = problem.residual_tangent(u, model)\n        if not np.all(np.isfinite(residual)) or not np.all(np.isfinite(jac)):\n            raise ValueError('nonfinite residual or tangent')\n        cache = u.copy(), residual, jac, boundaries\n        cost = float(residual@residual)\n        if best is None or cost < best[0]:\n            best = cost, u.copy()\n        return residual, jac, boundaries\n\n    staged = [i for i, name in enumerate(problem.bounds.active)\n              if name.startswith(('attitude_', 'velocity_', 'position_', 'accel_gain_'))]\n    stage_message = 'no staged parameters'; stage_calls = 0\n    if staged and len(point) > len(staged) and maximum_evaluations >= 40:\n        initial = point.copy(); end_stage = min(25, maximum_evaluations//5)\n        def expand(x):\n            full = initial.copy(); full[staged] = x; return full\n        def stage_fun(x):\n            if calls >= end_stage:\n                raise EvaluationLimit('initialization stage complete')\n            return evaluate(expand(x))[0]\n        try:\n            stage = least_squares(stage_fun, initial[staged],\n                jac=lambda x: evaluate(expand(x))[1][:, staged], bounds=(-1., 1.),\n                x_scale='jac', ftol=None, xtol=1e-11, gtol=1e-8,\n                max_nfev=min(25, maximum_evaluations//5))\n            stage_message = str(stage.message)\n        except EvaluationLimit as error:\n            stage_message = str(error)\n        point = best[1].copy(); stage_calls = calls\n\n    monitor = StableStop(); callback_stop = False; scipy_success = False; completed = False\n    message = 'not started'; termination = 'unresolved'\n    def callback(intermediate_result):\n        nonlocal callback_stop\n        residual, jac, _ = evaluate(intermediate_result.x)\n        if monitor.observe(intermediate_result.x, residual, jac):\n            callback_stop = True\n            raise StopIteration\n    try:\n        residual, jac, _ = evaluate(point)\n        monitor.observe(point, residual, jac)\n        if calls >= limit:\n            raise EvaluationLimit('native tangent evaluation allowance exhausted')\n        solution = least_squares(lambda u: evaluate(u)[0], point,\n            jac=lambda u: evaluate(u)[1], bounds=(-1., 1.), x_scale='jac',\n            ftol=None, xtol=1e-11, gtol=1e-14, max_nfev=limit-calls,\n            callback=callback)\n        point = solution.x.copy(); scipy_success = bool(solution.success)\n        completed = callback_stop or scipy_success\n        message = 'scaled stationarity and three stable accepted steps' if callback_stop else str(solution.message)\n        termination = 'scaled_stable_callback' if callback_stop else 'scipy_stop' if scipy_success else 'evaluation_limit'\n    except EvaluationLimit as error:\n        message = str(error); termination = 'evaluation_limit'\n        if best is not None:\n            point = best[1].copy()\n    if best is None:\n        raise ValueError('no finite candidate evaluation')\n    # The fresh check must use the returned/stopping point, not a different best trial.\n    limit = maximum_evaluations-2\n    residual, jac, boundaries = evaluate(point, fresh=True)\n    stationarity, gradient, projected, relative = projected_stationarity(point, residual, jac)\n    _, singular, right = np.linalg.svd(jac, full_matrices=False)\n    stable = bool(monitor.stable)\n    probe = None\n    if completed and not stable and stationarity <= 1e-4 and calls < maximum_evaluations-2:\n        # An exact/redundant optimum can stop before three accepted steps exist.\n        # Verify its bounded local least-squares correction with a real fresh sweep;\n        # never accept merely because a linearized correction is predicted to be small.\n        correction = lsq_linear(jac, -residual, bounds=(-1-point, 1-point),\n                                tol=1e-10, max_iter=100)\n        if correction.success and np.all(np.isfinite(correction.x)):\n            shifted = np.clip(point+correction.x, -1., 1.)\n            original_cost = float(residual@residual)\n            checked, _, _ = evaluate(shifted, fresh=True)\n            checked_cost = float(checked@checked)\n            change = abs(checked_cost-original_cost)/max(checked_cost, original_cost, 1.)\n            step = float(np.linalg.norm(checked-residual)/max(np.linalg.norm(residual), 1.))\n            stable = change <= POLICY['relative_cost_tolerance'] and step <= POLICY['relative_residual_step_tolerance']\n            probe = dict(relative_cost_change=change, relative_residual_step=step,\n                         normalized_parameter_step=correction.x.tolist(), successful=bool(stable))\n    converged = bool(completed and stable and stationarity <= 1e-4)\n    return dict(version=VERSION, model=model, parameters=problem.bounds.decode(point),\n        normalized_parameters=point.tolist(), active_parameters=list(problem.bounds.active),\n        residual_sum_squares=float(residual@residual), evaluations=calls,\n        maximum_evaluations=maximum_evaluations, initialization_evaluations=stage_calls,\n        initialization_message=stage_message, solver_reported_success=scipy_success,\n        stopping_rule_verified=completed, termination=termination, message=message,\n        converged=converged, exact_projected_gradient_relative=stationarity,\n        stationarity_tolerance=1e-4, stability_verified=stable,\n        stable_accepted_iterations=monitor.streak, relative_cost_change=monitor.cost_change,\n        relative_residual_step=monitor.residual_step, stability_probe=probe, gradient=gradient.tolist(),\n        projected_gradient=projected.tolist(), scaled_projected_gradient=relative.tolist(),\n        singular_values=singular.tolist(), right_singular_vectors=right.tolist(),\n        active_bounds=[name for name, u in zip(problem.bounds.active, point) if abs(u) >= .999],\n        active_bound_signs={name: 'upper' if u > 0 else 'lower'\n                           for name, u in zip(problem.bounds.active, point) if abs(u) >= .999},\n        gps_epochs_at_packet_boundaries=boundaries, derivative_method='forward automatic differentiation, 27 tangent lanes',\n        latency_derivative_convention='left interval at a packet boundary; adjacent measured rates may differ',\n        constant_bias_is_measured_drift=False, scientific_eligible=False, scientific_decision='abstain',\n        calibration_bounds_supported=False, processing_independence_established=False,\n        receiver_covariance_calibrated=False, clock_independently_established=False)\n"},"summary":"{\"bound_evaluations\":0,\"charged\":{\"bound_calls\":0,\"bound_steps\":0,\"native_calls\":1438896,\"packet_visits\":9036306072},\"charged_identities\":24,\"completed\":24,\"elapsed_s\":1863.132336139679,\"native_evaluations\":1438896,\"observational_coverage_qualified\":false,\"passed\":false,\"results\":[{\"artifact\":\"shards/000/results/increment-sphere_rotating-0-0.json\",\"artifact_sha256\":\"f76264da57d831bf7c00d09a99e7782f7a8c457d204cb23d54a9c4f9d68bd543\",\"charged\":{\"bound_calls\":0,\"bound_steps\":0,\"native_calls\":59954,\"packet_visits\":376512753},\"identity\":\"increment-sphere_rotating-0-0\",\"index\":0,\"passed\":true,\"status\":\"complete\"},{\"artifact\":\"shards/001/results/increment-sphere_rotating-0-1.json\",\"artifact_sha256\":\"a8bac7a6885eb081325bc3f637740b44f47eb072582244c7f81c9ed0986aa07b\",\"charged\":{\"bound_calls\":0,\"bound_steps\":0,\"native_calls\":59954,\"packet_visits\":376512753},\"identity\":\"increment-sphere_rotating-0-1\",\"index\":1,\"passed\":true,\"status\":\"complete\"},{\"artifact\":\"shards/002/results/increment-sphere_rotating-1-0.json\",\"artifact_sha256\":\"c73afd8b3